{
  "name": "todo-print-editor",
  "private": true,
  "version": "0.0.0",
  "description": "Design and print structured todo lists as exact-size A4 layouts from a visual or Markdown editor.",
  "homepage": "https://martonpaulo.github.io/todo-print-editor/",
  "repository": {
    "type": "git",
    "url": "https://github.com/martonpaulo/todo-print-editor.git"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run lint && npm run test && npm run build",
    "preview": "vite preview",
    "profile:build": "vite build --config vite.profile.config.ts",
    "profile:serve": "vite preview --config vite.profile.config.ts --host 127.0.0.1 --port 4183 --strictPort",
    "profile": "npm run profile:build && node scripts/profile.mjs"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.6",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "jsdom": "^30.0.1",
    "oxlint": "^1.75.0",
    "typescript": "~6.0.2",
    "vite": "^8.2.0",
    "vitest": "^4.1.11"
  }
}
